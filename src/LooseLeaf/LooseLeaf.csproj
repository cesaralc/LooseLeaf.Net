<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LooseLeaf</AssemblyName>
    <RootNamespace>LooseLeaf</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>LooseLeaf.Net</PackageId>
    <Description>LooseLeaf.Net is an open-source .NET library for strongly-typed extraction from documents, with pluggable OCR providers and field-level source provenance.</Description>
    <Authors>caviles</Authors>
    <RepositoryUrl>https://github.com/caviles/LooseLeaf.Net</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ocr;pdf;document-extraction;llm;ai</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0-rc.1.25451.107" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LooseLeaf.Tests" />
  </ItemGroup>

</Project>
